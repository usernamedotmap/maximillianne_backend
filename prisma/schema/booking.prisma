

model Booking {
    id String @id @default(uuid()) @db.Uuid
    trackingReference String @unique @map("tracking_reference") @db.Uuid
    guestId String @map("guest_id") @db.Uuid
    checkIn DateTime @map("check_in") @db.Date
    checkOut DateTime @map("check_out") @db.Date
    guestCount Int @map("guest_count") @db.SmallInt
    status BookingStatus @default(pending)
    expiresAt DateTime? @map("expires_at") @db.Timestamptz
    nightlyRate Decimal @map("nightly_rate") @db.Decimal(10, 2)
    totalAmount Decimal @map("total_mount") @db.Decimal(10, 2)
    notes String? @db.Text
    cancellationReason String? @map("cancellation_reason") @db.Text
    cancelledAt DateTime? @map("cancelled_at") @db.Timestamptz
    createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
    updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

    guest Guest @relation(fields: [guestId], references: [id], onDelete: Cascade)
    payment Payment[]

    @@index([checkIn, checkOut])
    @@index([status])
    @@index([status, expiresAt])
    @@map("bookings")

}
